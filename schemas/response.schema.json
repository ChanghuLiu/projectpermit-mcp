{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectpermit.example/schemas/check-project-requirements.response.json",
  "title": "check_project_requirements response",
  "type": "object",
  "required": ["determination", "requirements", "confidence", "disclaimer", "engine_version"],
  "properties": {
    "determination": {"enum": ["REQUIRED", "LIKELY_REQUIRED", "LIKELY_NOT_REQUIRED", "ADDITIONAL_REVIEW_REQUIRED", "MUNICIPAL_CONFIRMATION_REQUIRED", "OUT_OF_SCOPE"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "status", "reason", "rule_id", "rule_version", "source_verified_at", "evidence"],
        "properties": {
          "type": {"type": "string"},
          "status": {"enum": ["REQUIRED", "LIKELY_REQUIRED", "LIKELY_NOT_REQUIRED", "ADDITIONAL_REVIEW_REQUIRED", "MUNICIPAL_CONFIRMATION_REQUIRED", "OUT_OF_SCOPE"]},
          "reason": {"type": "string"},
          "rule_id": {"type": "string"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["authority", "title", "url", "source_id"],
              "properties": {
                "authority": {"type": "string"},
                "title": {"type": "string"},
                "url": {"type": "string", "format": "uri"},
                "source_id": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "rule_version": {"type": "string"},
          "source_verified_at": {"type": "string", "format": "date"}
        }
      }
    },
    "property_context_status": {
      "enum": ["UNRESOLVED_FOR_EXEMPTION"],
      "description": "Present when a no-permit path cannot be trusted until parcel-specific property context is resolved."
    },
    "required_property_facts": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "minItems": 1,
      "description": "Property facts that must be resolved before relying on the otherwise applicable exemption."
    },
    "disclaimer": {"type": "string"},
    "engine_version": {"type": "string"}
  }
}
